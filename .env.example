# Server
PORT=3001
NODE_ENV=development

# JWT — change this to a strong random secret in production
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars

# Database
DB_PATH=./data/streakr.db

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Email (Nodemailer) — for password reset
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your-smtp-password
EMAIL_FROM="Streakr <noreply@streakr.app>"

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_EMAIL=mailto:admin@streakr.app

# Google OAuth (optional — uncomment in routes/auth.js to enable)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
